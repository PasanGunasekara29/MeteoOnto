                                                 owl:versionIRI <http://meteo_onto.org/meteo_geo_dbpedia_align/GEO_DBPEDIA_ALIGNV1_0> ;
                                                 owl:imports <https://pasangunasekara29.github.io/MeteoOnto/Meteo_Onto_Core_Geo_Combined.ttl> ;
                                                 rdfs:comment "Mappings from classes in the imported MeteoOnto Core and Geo ontology to DBpedia. Subclass axioms are used only where the MeteoOnto class is intended to be a narrower class of a DBpedia ontology class. SKOS mappings indicate close or related concepts and do not cause OWL class-membership inference."@en ;
                                                 rdfs:label "MeteoOnto Geo DBpedia Alignment"@en .

