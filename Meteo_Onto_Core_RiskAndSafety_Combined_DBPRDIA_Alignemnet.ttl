#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  http://dbpedia.org/ontology/Event
dbo:Event rdf:type owl:Class .


###  http://dbpedia.org/ontology/GovernmentAgency
dbo:GovernmentAgency rdf:type owl:Class .


###  http://dbpedia.org/ontology/Hospital
dbo:Hospital rdf:type owl:Class .


###  http://dbpedia.org/ontology/Organisation
dbo:Organisation rdf:type owl:Class .


###  http://dbpedia.org/ontology/Place
dbo:Place rdf:type owl:Class .


###  http://dbpedia.org/ontology/School
dbo:School rdf:type owl:Class .


###  http://meteo_onto.org/meteo_risk/EmergencyResponseAgency
Risk:EmergencyResponseAgency rdfs:subClassOf dbo:Organisation .


###  http://meteo_onto.org/meteo_risk/GeographicFeature
Risk:GeographicFeature rdfs:subClassOf dbo:Place .


###  http://meteo_onto.org/meteo_risk/GovernmentAuthority
