                                                      owl:versionIRI <http://meteo_onto.org/meteo_risk_dbpedia_alignment/1.0> ;
                                                      owl:imports <https://pasangunasekara29.github.io/MeteoOnto/Meteo_Onto_Core_RiskAndSafety_Combined.ttl> ;
                                                      rdfs:comment "Alignments for classes in the MeteoOnto Risk and Safety namespace. rdfs:subClassOf links support inference to a broader DBpedia ontology class; SKOS matches record close or related concepts without asserting OWL class equivalence."@en ;
