@prefix : <http://meteo_onto.org/meteo_core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix meteo_core: <http://meteo_onto.org/meteo_core/> .
@prefix meteo_data: <http://meteo_onto.org/meteo_data/> .
@base <http://meteo_onto.org/meteo_core#> .

<http://meteo_onto.org/meteo_core_sosa_ssn_align> rdf:type owl:Ontology ;
                                                   owl:versionIRI meteo_core:SOSA_SSN_ALIGN_1 ;
                                                   owl:imports <https://pasangunasekara29.github.io/MeteoOnto/Meteo_Onto_Core.ttl> ;
                                                   terms:contributor "Prof. Dulani Meedeniya"@en ;
                                                   terms:creator "H. K. Pasan Gunasekara"@en ;
                                                   terms:description "This ontology represents a meteorological domain ontology designed to semantically model and manage real-time weather observations, historical climate observations, and reanalysis datasets. The ontology supports metadata-driven semantic integration, interoperability, and scalable environmental data management for enterprise knowledge graph systems."@en ;
                                                   terms:license "https://creativecommons.org/licenses/by/4.0/"@en ;
                                                   terms:title "Meteo_Onto_Core"@en ;
                                                   owl:versionInfo "http://meteo_onto.org/meteo_core/SOSA_SSN_ALIGN_1"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/contributor
terms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
terms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
terms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
terms:issued rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
terms:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
terms:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
terms:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
terms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#note
skos:note rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://meteo_onto.org/meteo_core/wktLiteral
meteo_core:wktLiteral rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://meteo_onto.org/meteo_core/deploy
meteo_core:deploy rdfs:subPropertyOf ssn:inDeployment .


###  http://meteo_onto.org/meteo_core/hasDeployment
meteo_core:hasDeployment rdfs:subPropertyOf ssn:hasDeployment .


###  http://meteo_onto.org/meteo_core/hasMember
meteo_core:hasMember rdfs:subPropertyOf sosa:hasMember .


###  http://meteo_onto.org/meteo_core/hasObservationTime
meteo_core:hasObservationTime rdfs:subPropertyOf sosa:phenomenonTime .


###  http://meteo_onto.org/meteo_core/hasResult
meteo_core:hasResult rdfs:subPropertyOf sosa:hasResult .


###  http://meteo_onto.org/meteo_core/hosts
meteo_core:hosts rdfs:subPropertyOf sosa:hosts .


###  http://meteo_onto.org/meteo_core/implement
meteo_core:implement rdfs:subPropertyOf ssn:implements .


###  http://meteo_onto.org/meteo_core/isDeployedBy
meteo_core:isDeployedBy rdfs:subPropertyOf ssn:deployedOnPlatform .


###  http://meteo_onto.org/meteo_core/isDeploymentOf
meteo_core:isDeploymentOf rdfs:subPropertyOf ssn:deployedSystem .


###  http://meteo_onto.org/meteo_core/isHostedBy
meteo_core:isHostedBy rdfs:subPropertyOf sosa:isHostedBy .


###  http://meteo_onto.org/meteo_core/isImplementedBy
meteo_core:isImplementedBy rdfs:subPropertyOf ssn:implementedBy .


###  http://meteo_onto.org/meteo_core/isResultOf
meteo_core:isResultOf rdfs:subPropertyOf sosa:isResultOf .


###  http://meteo_onto.org/meteo_core/isUsedBy
meteo_core:isUsedBy rdfs:subPropertyOf sosa:usedProcedure .


###  http://meteo_onto.org/meteo_core/madeBySensor
meteo_core:madeBySensor rdfs:subPropertyOf meteo_core:hasDataAttributeOf ,
                                           sosa:madeBySensor .


###  http://meteo_onto.org/meteo_core/observedProperty
meteo_core:observedProperty rdfs:subPropertyOf sosa:observedProperty .


###  http://meteo_onto.org/meteo_core/observes
meteo_core:observes rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf sosa:observes .


###  http://www.w3.org/ns/sosa/hasMember
sosa:hasMember rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasResult
sosa:hasResult rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hosts
sosa:hosts rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/isHostedBy
sosa:isHostedBy rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/isResultOf
sosa:isResultOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/madeBySensor
sosa:madeBySensor rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/observedProperty
sosa:observedProperty rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/observes
sosa:observes rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/phenomenonTime
sosa:phenomenonTime rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/usedProcedure
sosa:usedProcedure rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/ssn/deployedOnPlatform
ssn:deployedOnPlatform rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/ssn/deployedSystem
ssn:deployedSystem rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/ssn/hasDeployment
ssn:hasDeployment rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/ssn/implementedBy
ssn:implementedBy rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/ssn/implements
ssn:implements rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/ssn/inDeployment
ssn:inDeployment rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://meteo_onto.org/meteo_core/hasResultTime
meteo_core:hasResultTime rdfs:subPropertyOf sosa:hasSimpleResult .


###  http://www.w3.org/ns/sosa/hasSimpleResult
sosa:hasSimpleResult rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://meteo_onto.org/meteo_core/DataCollection
meteo_core:DataCollection rdfs:subClassOf sosa:ObservationCollection .


###  http://meteo_onto.org/meteo_core/Deployment
meteo_core:Deployment rdfs:subClassOf ssn:Deployment .


###  http://meteo_onto.org/meteo_core/MeteorologicalModel
meteo_core:MeteorologicalModel rdf:type owl:Class ;
                               rdfs:subClassOf ssn:System .


###  http://meteo_onto.org/meteo_core/ObservableProperty
meteo_core:ObservableProperty rdfs:subClassOf sosa:ObservableProperty .


###  http://meteo_onto.org/meteo_core/Observation
meteo_core:Observation rdfs:subClassOf sosa:Observation .


###  http://meteo_onto.org/meteo_core/Platform
meteo_core:Platform rdfs:subClassOf sosa:Platform .


###  http://meteo_onto.org/meteo_core/Procedure
meteo_core:Procedure rdfs:subClassOf sosa:Procedure .


###  http://meteo_onto.org/meteo_core/Result
meteo_core:Result rdfs:subClassOf sosa:Result .


###  http://meteo_onto.org/meteo_core/Sensor
meteo_core:Sensor rdfs:subClassOf sosa:Sensor .


###  http://www.w3.org/ns/sosa/ObservableProperty
sosa:ObservableProperty rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Observation
sosa:Observation rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/ObservationCollection
sosa:ObservationCollection rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Platform
sosa:Platform rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Procedure
sosa:Procedure rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Result
sosa:Result rdf:type owl:Class .


###  http://www.w3.org/ns/sosa/Sensor
sosa:Sensor rdf:type owl:Class .


###  http://www.w3.org/ns/ssn/Deployment
ssn:Deployment rdf:type owl:Class .


###  http://www.w3.org/ns/ssn/System
ssn:System rdf:type owl:Class .


