#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
dc:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
terms:license rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://meteo_onto.org/meteo_core/wktLiteral
Core:wktLiteral owl:equivalentClass Geo:WKTLiteral ,
                                    <http://www.opengis.net/ont/geosparql#wktLiteral> .


###  http://meteo_onto.org/meteo_geo/WKTLiteral
Geo:WKTLiteral rdf:type rdfs:Datatype ;
               owl:equivalentClass <http://www.opengis.net/ont/geosparql#wktLiteral> .


#################################################################
#    Object Properties
#################################################################

###  http://meteo_onto.org/meteo_geo/hasContain
Geo:hasContain owl:equivalentProperty <http://www.opengis.net/ont/geosparql#sfContains> .


###  http://meteo_onto.org/meteo_geo/hasGeometry
Geo:hasGeometry owl:equivalentProperty <http://www.opengis.net/ont/geosparql#hasGeometry> .


###  http://meteo_onto.org/meteo_geo/hasIntersection
Geo:hasIntersection owl:equivalentProperty <http://www.opengis.net/ont/geosparql#sfIntersects> .


###  http://meteo_onto.org/meteo_geo/hasOverlap
Geo:hasOverlap owl:equivalentProperty <http://www.opengis.net/ont/geosparql#sfTouches> .


###  http://meteo_onto.org/meteo_geo/isWithIn
Geo:isWithIn owl:equivalentProperty <http://www.opengis.net/ont/geosparql#sfWithin> .


###  http://www.opengis.net/ont/geosparql#sfContains
<http://www.opengis.net/ont/geosparql#sfContains> rdf:type owl:ObjectProperty .


#################################################################
#    Data properties
#################################################################

###  http://meteo_onto.org/meteo_geo/hasCoordinate
Geo:hasCoordinate rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain Geo:GeoGeometry ;
                  rdfs:range Geo:WKTLiteral .


###  http://meteo_onto.org/meteo_geo/hasName
Geo:hasName rdf:type owl:DatatypeProperty .


#################################################################
#    Classes
#################################################################

###  http://meteo_onto.org/meteo_geo/GeoFeature
Geo:GeoFeature rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> .


###  http://meteo_onto.org/meteo_geo/GeoGeometry
Geo:GeoGeometry rdf:type owl:Class ;
                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Geometry> .


###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class .


###  http://www.opengis.net/ont/geosparql#SpatialObject
<http://www.opengis.net/ont/geosparql#SpatialObject> rdf:type owl:Class .


